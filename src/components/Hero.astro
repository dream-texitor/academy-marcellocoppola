---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  microcopy?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  text,
  primaryLabel = "Richiedi una proposta",
  primaryHref = "/richiedi-proposta-formazione-ai",
  secondaryLabel,
  secondaryHref,
  microcopy
} = Astro.props;
---

<section class="hero">
  <div class="container hero-grid">
    <div class="stack">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lead">{subtitle}</p>
      {text && <p class="hero-text">{text}</p>}
      <div class="button-row">
        <a class="button button--primary" href={primaryHref}>{primaryLabel}</a>
        {secondaryLabel && secondaryHref && <a class="button button--secondary" href={secondaryHref}>{secondaryLabel}</a>}
      </div>
      {microcopy && <p class="microcopy">{microcopy}</p>}
    </div>
    <slot name="aside">
      <aside class="hero-panel" aria-label="Sintesi normativa">
        <span class="pill">Obbligo AI Literacy</span>
        <p>L'AI Act richiede misure formative adeguate e documentabili per chi utilizza sistemi di intelligenza artificiale nel lavoro quotidiano.</p>
      </aside>
    </slot>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
    padding: 56px 0 46px;
    background: linear-gradient(180deg, #f7fafc 0%, #ffffff 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
    gap: 28px;
    align-items: center;
  }

  .hero-text {
    max-width: 780px;
    color: var(--slate);
  }

  .microcopy {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .hero-panel {
    border: 1px solid var(--line);
    border-top: 4px solid var(--teal);
    border-radius: var(--radius);
    background: var(--white);
    padding: 20px;
    box-shadow: var(--shadow);
  }

  .hero-panel p {
    margin-top: 12px;
    color: var(--slate);
    font-weight: 650;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 42px 0 34px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
