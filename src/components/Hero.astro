---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  microcopy?: string;
}

const {
  eyebrow,
  title,
  subtitle,
  text,
  primaryLabel = "Richiedi una proposta",
  primaryHref = "/richiedi-proposta-formazione-ai",
  secondaryLabel,
  secondaryHref,
  microcopy
} = Astro.props;
---

<section class="hero">
  <div class="hero-pattern" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="stack">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      <p class="lead">{subtitle}</p>
      {text && <p class="hero-text">{text}</p>}
      <div class="button-row">
        <a class="button button--primary" href={primaryHref}>{primaryLabel}</a>
        {secondaryLabel && secondaryHref && <a class="button button--secondary" href={secondaryHref}>{secondaryLabel}</a>}
      </div>
      {microcopy && <p class="microcopy">{microcopy}</p>}
    </div>
    <slot name="aside">
      <aside class="hero-panel" aria-label="Sintesi normativa">
        <span class="pill">Obbligo AI Literacy</span>
        <p>L'AI Act richiede misure formative adeguate e documentabili per chi utilizza sistemi di intelligenza artificiale nel lavoro quotidiano.</p>
      </aside>
    </slot>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
    padding: 64px 0 52px;
    background:
      radial-gradient(circle at 88% 18%, rgba(15, 159, 149, 0.18), transparent 22rem),
      radial-gradient(circle at 8% 12%, rgba(18, 58, 90, 0.12), transparent 26rem),
      linear-gradient(135deg, #f4f9fb 0%, #fbfaf6 56%, #ffffff 100%);
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(7, 29, 51, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(7, 29, 51, 0.045) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(90deg, transparent, #000 18%, #000 82%, transparent);
    pointer-events: none;
  }

  .hero-pattern {
    position: absolute;
    right: min(4vw, 64px);
    top: 24px;
    width: 260px;
    height: 260px;
    border: 1px solid rgba(15, 159, 149, 0.18);
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(15, 159, 149, 0.18) 0 3px, transparent 4px),
      radial-gradient(circle at 68% 34%, rgba(7, 29, 51, 0.14) 0 4px, transparent 5px),
      radial-gradient(circle at 28% 72%, rgba(7, 29, 51, 0.12) 0 3px, transparent 4px);
    opacity: 0.55;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 360px);
    gap: 28px;
    align-items: center;
  }

  .hero-text {
    max-width: 780px;
    color: var(--slate);
  }

  .hero h1 {
    text-wrap: balance;
  }

  .microcopy {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .hero-panel {
    border: 1px solid var(--line);
    border-top: 4px solid var(--teal);
    border-radius: var(--radius);
    background: var(--white);
    padding: 20px;
    box-shadow: var(--shadow);
  }

  .hero-panel p {
    margin-top: 12px;
    color: var(--slate);
    font-weight: 650;
  }

  @media (max-width: 900px) {
    .hero {
      padding: 42px 0 34px;
    }

    .hero-pattern {
      display: none;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
