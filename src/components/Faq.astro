---
import { faq } from "@data/site";
---

<section class="section">
  <div class="container stack">
    <div class="stack">
      <p class="eyebrow">FAQ</p>
      <h2>Domande frequenti</h2>
    </div>
    <div class="faq-list">
      {faq.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: grid;
    gap: 10px;
  }

  .faq-item {
    border: 1px solid rgba(216, 228, 238, 0.9);
    border-radius: 12px;
    background: linear-gradient(180deg, #ffffff, #f8fbfd);
    padding: 16px 18px;
    box-shadow: 0 8px 24px rgba(7, 29, 51, 0.05);
  }

  .faq-item summary {
    cursor: pointer;
    color: var(--navy);
    font-weight: 850;
    list-style-position: outside;
  }

  .faq-item p {
    margin-top: 12px;
    color: var(--slate);
  }
</style>
