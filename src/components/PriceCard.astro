---
interface Props {
  badge?: string;
  title: string;
  price: string;
  details: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  badge = "Percorso documentabile",
  title,
  price,
  details,
  ctaLabel = "Richiedi una proposta",
  ctaHref = "/richiedi-proposta-formazione-ai"
} = Astro.props;
---

<aside class="price-card" aria-label={title}>
  <span class="price-badge">{badge}</span>
  <h2>{title}</h2>
  <p class="price">{price}</p>
  <p class="details">{details}</p>
  <a class="button button--primary" href={ctaHref}>{ctaLabel}</a>
</aside>

<style>
  .price-card {
    position: relative;
    display: grid;
    gap: 12px;
    align-content: start;
    overflow: hidden;
    border: 1px solid rgba(15, 159, 149, 0.22);
    border-top: 5px solid var(--teal);
    border-radius: 16px;
    background:
      radial-gradient(circle at 96% 8%, rgba(15, 159, 149, 0.16), transparent 8rem),
      linear-gradient(180deg, #ffffff, #f6fbfc);
    padding: 24px;
    box-shadow: 0 22px 56px rgba(7, 29, 51, 0.14);
  }

  .price-card::after {
    content: "";
    position: absolute;
    right: 24px;
    bottom: 22px;
    width: 72px;
    height: 72px;
    border: 1px solid rgba(15, 159, 149, 0.16);
    border-radius: 50%;
    pointer-events: none;
  }

  .price-card h2 {
    font-size: 1.24rem;
    position: relative;
  }

  .price-badge {
    width: fit-content;
    border: 1px solid rgba(15, 159, 149, 0.32);
    border-radius: 999px;
    color: var(--teal-dark);
    background: rgba(255, 255, 255, 0.74);
    padding: 4px 10px;
    font-size: 0.76rem;
    font-weight: 850;
    position: relative;
  }

  .details {
    color: var(--slate);
    font-weight: 650;
    position: relative;
  }

  .price-card .button {
    position: relative;
    margin-top: 4px;
  }
</style>
