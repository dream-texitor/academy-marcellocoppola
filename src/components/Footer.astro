---
import { navItems, site } from "@data/site";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="stack">
      <a class="footer-logo-link" href="/" aria-label="Marcello Coppola Academy home">
        <img src="/assets/logo-marcello-coppola-academy.png" alt="Marcello Coppola Academy" class="footer-logo" />
      </a>
      <h2>{site.name}</h2>
      <p>{site.payoff}</p>
      <div class="company-data">
        <p><strong>{site.company.name}</strong></p>
        <p>{site.company.address}</p>
        <p>{site.company.city}</p>
        <p>{site.company.vat}</p>
        <p>{site.company.rea}</p>
      </div>
    </div>
    <nav class="footer-links" aria-label="Link footer">
      {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/privacy-policy">Privacy Policy</a>
      <a href="/termini-e-condizioni">Termini e Condizioni</a>
    </nav>
    <div class="stack">
      <p><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p><strong>Sito:</strong> academy.marcellocoppola.com</p>
      <p class="footer-note">{site.legalNote}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background:
      radial-gradient(circle at 88% 0%, rgba(15, 159, 149, 0.16), transparent 20rem),
      linear-gradient(135deg, #061a2e, var(--navy));
    color: var(--white);
    padding: 44px 0;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr 1.25fr;
    gap: 30px;
  }

  .site-footer h2 {
    color: var(--white);
    font-size: 1.4rem;
  }

  .footer-logo-link {
    display: inline-flex;
    width: fit-content;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.94);
    padding: 8px 10px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.14);
  }

  .footer-logo {
    display: block;
    width: auto;
    height: 42px;
    max-width: 280px;
    object-fit: contain;
  }

  .company-data {
    display: grid;
    gap: 3px;
    color: #d8e5ef;
    font-size: 0.94rem;
  }

  .footer-links {
    display: grid;
    gap: 7px;
  }

  .site-footer a:hover {
    color: #8ee3dc;
  }

  .site-footer .muted,
  .footer-note {
    color: #c9d6e2;
  }

  .footer-note {
    font-size: 0.92rem;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
