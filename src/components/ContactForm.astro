---
const endpoint = import.meta.env.CONTACT_FORM_ENDPOINT ?? "";
---

<form class="contact-form" data-contact-form data-endpoint={endpoint} method="post">
  <div class="form-grid">
    <label>
      Nome e cognome *
      <input name="name" autocomplete="name" required />
    </label>
    <label>
      Organizzazione
      <input name="organization" autocomplete="organization" />
    </label>
    <label>
      Email *
      <input name="email" type="email" autocomplete="email" required />
    </label>
    <label>
      Telefono
      <input name="phone" type="tel" autocomplete="tel" />
    </label>
    <label>
      Target di interesse *
      <select name="target" required>
        <option value="">Seleziona</option>
        <option>Hotel</option>
        <option>Azienda</option>
        <option>Professionista</option>
        <option>PA</option>
        <option>Cittadini</option>
        <option>Altro</option>
      </select>
    </label>
  </div>
  <label>
    Messaggio *
    <textarea name="message" rows="6" required></textarea>
  </label>
  <label class="privacy">
    <input name="privacy" type="checkbox" required />
    <span>Confermo di aver letto l'informativa privacy e autorizzo il trattamento dei dati per essere ricontattato.</span>
  </label>
  <label class="honeypot" aria-hidden="true" tabindex="-1">
    Non compilare questo campo
    <input name="website" tabindex="-1" autocomplete="off" />
  </label>
  <input type="hidden" name="sourcePage" data-source-page />
  <button class="button button--primary" type="submit" data-submit>Richiedi proposta</button>
  <p class="form-status" role="status" aria-live="polite" data-status></p>
</form>

<script>
  const form = document.querySelector("[data-contact-form]");
  const statusEl = document.querySelector("[data-status]");
  const submitButton = document.querySelector("[data-submit]");
  const sourceInput = document.querySelector("[data-source-page]");

  if (sourceInput instanceof HTMLInputElement) {
    sourceInput.value = window.location.href;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    if (!(form instanceof HTMLFormElement)) return;
    const endpoint = form.dataset.endpoint;

    if (!form.reportValidity()) return;

    const data = new FormData(form);
    if (String(data.get("website") || "").trim()) {
      return;
    }

    if (!endpoint) {
      if (statusEl) statusEl.textContent = "Endpoint non configurato. Scrivi a academy@marcellocoppola.com.";
      return;
    }

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = true;
      submitButton.textContent = "Invio in corso...";
    }
    if (statusEl) statusEl.textContent = "";

    try {
      const response = await fetch(endpoint, {
        method: "POST",
        headers: { Accept: "application/json" },
        body: data
      });

      if (!response.ok) throw new Error("Invio non riuscito");
      form.reset();
      if (statusEl) statusEl.textContent = "Richiesta inviata correttamente. Ti risponderemo appena possibile.";
    } catch {
      if (statusEl) statusEl.textContent = "Non è stato possibile inviare la richiesta. Scrivi a academy@marcellocoppola.com.";
    } finally {
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
        submitButton.textContent = "Richiedi proposta";
      }
    }
  });
</script>

<style>
  .contact-form {
    display: grid;
    gap: 16px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  label {
    display: grid;
    gap: 6px;
    color: var(--navy);
    font-size: 0.94rem;
    font-weight: 780;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid rgba(216, 228, 238, 0.95);
    border-radius: 12px;
    background: linear-gradient(180deg, #ffffff, #fbfdfe);
    color: var(--navy);
    padding: 12px 14px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9);
    transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--teal);
    background: var(--white);
    box-shadow: 0 0 0 4px rgba(15, 159, 149, 0.14);
  }

  .privacy {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: var(--slate);
    font-weight: 500;
    border-radius: 12px;
    background: rgba(243, 248, 251, 0.72);
    padding: 12px;
  }

  .privacy input {
    width: auto;
    margin-top: 7px;
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .form-status {
    color: var(--teal-dark);
    font-weight: 800;
    min-height: 1.4em;
  }

  button:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  @media (max-width: 760px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
